{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nextstat.io/schemas/benchmarks/mams_stress_assessment_v1.schema.json",
  "title": "NextStat MAMS Stress Assessment v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite", "source_summary_path", "source_summary_sha256", "stress_readiness", "supported_repeatability_gate", "pathological_control_health"],
  "properties": {
    "schema_version": { "const": "nextstat.mams_stress_assessment.v1" },
    "suite": { "const": "mams_stress" },
    "source_summary_path": { "const": "mams_stress_multiseed_summary.json" },
    "source_summary_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "stress_readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "status", "components"],
      "properties": {
        "passed": { "type": "boolean" },
        "status": { "type": "string", "enum": ["passed", "failed"] },
        "components": {
          "type": "object",
          "additionalProperties": false,
          "required": ["supported_repeatability_gate", "pathological_control_health"],
          "properties": {
            "supported_repeatability_gate": { "type": "string", "enum": ["passed", "failed"] },
            "pathological_control_health": { "type": "string", "enum": ["passed", "failed"] }
          }
        }
      }
    },
    "supported_repeatability_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "status", "target_backend", "policy", "reviewed_cases", "reviewed_parity_cases", "failures", "review_summary"],
      "properties": {
        "passed": { "type": "boolean" },
        "status": { "type": "string", "enum": ["passed", "failed"] },
        "target_backend": { "type": "string", "minLength": 1 },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_r_hat", "parity_warn_z", "parity_fail_z", "require_complete_seed_coverage", "require_all_backend_statuses_ok", "require_all_parity_statuses_ok"],
          "properties": {
            "max_r_hat": { "type": "number", "minimum": 0 },
            "parity_warn_z": { "type": ["number", "null"], "minimum": 0 },
            "parity_fail_z": { "type": ["number", "null"], "minimum": 0 },
            "require_complete_seed_coverage": { "type": "boolean" },
            "require_all_backend_statuses_ok": { "type": "boolean" },
            "require_all_parity_statuses_ok": { "type": "boolean" }
          }
        },
        "reviewed_cases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["case", "case_tier", "backend", "n_observed_seeds", "statuses", "worst_max_r_hat", "worst_min_ess_bulk", "worst_min_ess_tail", "worst_ess_per_sec", "worst_accept_rate"],
            "properties": {
              "case": { "type": "string", "minLength": 1 },
              "case_tier": { "type": "string", "const": "supported" },
              "backend": { "type": "string", "minLength": 1 },
              "n_observed_seeds": { "type": "integer", "minimum": 0 },
              "statuses": { "type": "array", "items": { "type": "string" } },
              "worst_max_r_hat": { "type": ["number", "null"], "minimum": 0 },
              "worst_min_ess_bulk": { "type": ["number", "null"], "minimum": 0 },
              "worst_min_ess_tail": { "type": ["number", "null"], "minimum": 0 },
              "worst_ess_per_sec": { "type": ["number", "null"], "minimum": 0 },
              "worst_accept_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
            }
          }
        },
        "reviewed_parity_cases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["case", "case_tier", "n_observed_seeds", "statuses", "worst_max_z"],
            "properties": {
              "case": { "type": "string", "minLength": 1 },
              "case_tier": { "type": "string", "const": "supported" },
              "n_observed_seeds": { "type": "integer", "minimum": 0 },
              "statuses": { "type": "array", "items": { "type": "string" } },
              "worst_max_z": { "type": ["number", "null"], "minimum": 0 }
            }
          }
        },
        "failures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["case", "reason"],
            "properties": {
              "case": { "type": ["string", "null"] },
              "reason": { "type": "string", "minLength": 1 },
              "statuses": { "type": "array", "items": { "type": "string" } },
              "observed": { "type": "number", "minimum": 0 },
              "threshold": { "type": "number", "minimum": 0 },
              "warn_threshold": { "type": "number", "minimum": 0 },
              "fail_threshold": { "type": "number", "minimum": 0 },
              "observed_count": { "type": "integer", "minimum": 0 },
              "expected_count": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "review_summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["n_reviewed_cases", "n_reviewed_parity_cases", "n_failures", "n_failing_cases", "failing_cases"],
          "properties": {
            "n_reviewed_cases": { "type": "integer", "minimum": 0 },
            "n_reviewed_parity_cases": { "type": "integer", "minimum": 0 },
            "n_failures": { "type": "integer", "minimum": 0 },
            "n_failing_cases": { "type": "integer", "minimum": 0 },
            "failing_cases": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "worst_max_r_hat": { "$ref": "#/$defs/caseValuePair" },
            "worst_min_ess_bulk": { "$ref": "#/$defs/caseValuePair" },
            "worst_min_ess_tail": { "$ref": "#/$defs/caseValuePair" },
            "worst_ess_per_sec": { "$ref": "#/$defs/caseValuePair" },
            "worst_accept_rate": { "$ref": "#/$defs/caseValuePair" },
            "worst_parity_max_z": { "$ref": "#/$defs/caseValuePair" }
          }
        }
      }
    },
    "pathological_control_health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "status", "target_backend", "policy", "reviewed_cases", "failures", "review_summary"],
      "properties": {
        "passed": { "type": "boolean" },
        "status": { "type": "string", "enum": ["passed", "failed"] },
        "target_backend": { "type": "string", "minLength": 1 },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["require_complete_seed_coverage", "allow_warn_statuses", "fail_on_backend_status_failed"],
          "properties": {
            "require_complete_seed_coverage": { "type": "boolean" },
            "allow_warn_statuses": { "type": "boolean" },
            "fail_on_backend_status_failed": { "type": "boolean" }
          }
        },
        "reviewed_cases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["case", "case_tier", "backend", "n_observed_seeds", "statuses", "worst_max_r_hat", "worst_min_ess_bulk", "worst_min_ess_tail", "worst_ess_per_sec", "worst_accept_rate"],
            "properties": {
              "case": { "type": "string", "minLength": 1 },
              "case_tier": { "type": "string", "const": "pathological_control" },
              "backend": { "type": "string", "minLength": 1 },
              "n_observed_seeds": { "type": "integer", "minimum": 0 },
              "statuses": { "type": "array", "items": { "type": "string" } },
              "worst_max_r_hat": { "type": ["number", "null"], "minimum": 0 },
              "worst_min_ess_bulk": { "type": ["number", "null"], "minimum": 0 },
              "worst_min_ess_tail": { "type": ["number", "null"], "minimum": 0 },
              "worst_ess_per_sec": { "type": ["number", "null"], "minimum": 0 },
              "worst_accept_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
            }
          }
        },
        "failures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["case", "reason"],
            "properties": {
              "case": { "type": ["string", "null"] },
              "reason": { "type": "string", "minLength": 1 },
              "statuses": { "type": "array", "items": { "type": "string" } },
              "observed_count": { "type": "integer", "minimum": 0 },
              "expected_count": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "review_summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["n_reviewed_cases", "n_failures", "n_failing_cases", "failing_cases"],
          "properties": {
            "n_reviewed_cases": { "type": "integer", "minimum": 0 },
            "n_failures": { "type": "integer", "minimum": 0 },
            "n_failing_cases": { "type": "integer", "minimum": 0 },
            "failing_cases": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "worst_max_r_hat": { "$ref": "#/$defs/caseValuePair" },
            "worst_min_ess_bulk": { "$ref": "#/$defs/caseValuePair" },
            "worst_min_ess_tail": { "$ref": "#/$defs/caseValuePair" },
            "worst_ess_per_sec": { "$ref": "#/$defs/caseValuePair" },
            "worst_accept_rate": { "$ref": "#/$defs/caseValuePair" }
          }
        }
      }
    }
  },
  "$defs": {
    "caseValuePair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case", "value"],
      "properties": {
        "case": { "type": ["string", "null"] },
        "value": { "type": ["number", "null"], "minimum": 0 }
      }
    }
  }
}
