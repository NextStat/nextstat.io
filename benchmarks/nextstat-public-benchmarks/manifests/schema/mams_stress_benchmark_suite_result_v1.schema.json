{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nextstat.io/schemas/benchmarks/mams_stress_benchmark_suite_result_v1.schema.json",
  "title": "NextStat MAMS Stress Benchmark Suite Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite", "deterministic", "meta", "config", "case_catalog", "cases", "summary", "parity"],
  "properties": {
    "schema_version": { "const": "nextstat.mams_stress_benchmark_suite_result.v1" },
    "suite": { "const": "mams_stress" },
    "deterministic": { "type": "boolean" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "platform", "nextstat_version"],
      "properties": {
        "python": { "type": "string" },
        "platform": { "type": "string" },
        "nextstat_version": { "type": "string" }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n_chains", "n_warmup", "n_samples", "dataset_seed", "target_accept", "n_groups", "n_per_group", "seeds", "backends", "parity_warn_z", "parity_fail_z"],
      "properties": {
        "n_chains": { "type": "integer", "minimum": 1 },
        "n_warmup": { "type": "integer", "minimum": 0 },
        "n_samples": { "type": "integer", "minimum": 1 },
        "dataset_seed": { "type": "integer", "minimum": 0 },
        "target_accept": { "type": "number", "minimum": 0, "maximum": 1 },
        "n_groups": { "type": "integer", "minimum": 1 },
        "n_per_group": { "type": "integer", "minimum": 1 },
        "seeds": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 1 },
        "backends": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "parity_warn_z": { "type": "number", "minimum": 0 },
        "parity_fail_z": { "type": "number", "minimum": 0 }
      }
    },
    "case_catalog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case", "case_tier", "parity_scope", "description"],
        "properties": {
          "case": { "type": "string", "minLength": 1 },
          "case_tier": { "type": "string", "enum": ["supported", "pathological_control"] },
          "parity_scope": { "type": "string", "enum": ["required", "informational"] },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case", "case_tier", "backend", "seed", "path", "sha256", "status"],
        "properties": {
          "case": { "type": "string", "minLength": 1 },
          "case_tier": { "type": "string", "enum": ["supported", "pathological_control"] },
          "backend": { "type": "string", "enum": ["nextstat_mams", "nextstat_nuts", "blackjax_mclmc"] },
          "seed": { "type": "integer", "minimum": 0 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "status": { "type": "string", "enum": ["ok", "warn", "failed"] },
          "config_overrides": { "type": ["object", "null"], "additionalProperties": true },
          "wall_time_s": { "type": ["number", "null"], "minimum": 0 },
          "n_grad_evals": { "type": ["integer", "null"], "minimum": 0 },
          "min_ess_bulk": { "type": ["number", "null"], "minimum": 0 },
          "ess_per_grad": { "type": ["number", "null"], "minimum": 0 },
          "ess_per_sec": { "type": ["number", "null"], "minimum": 0 },
          "max_r_hat": { "type": ["number", "null"], "minimum": 0 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n_total", "n_ok", "n_warn", "n_failed", "n_parity_warn", "n_parity_fail"],
      "properties": {
        "n_total": { "type": "integer", "minimum": 0 },
        "n_ok": { "type": "integer", "minimum": 0 },
        "n_warn": { "type": "integer", "minimum": 0 },
        "n_failed": { "type": "integer", "minimum": 0 },
        "n_parity_warn": { "type": "integer", "minimum": 0 },
        "n_parity_fail": { "type": "integer", "minimum": 0 }
      }
    },
    "parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "note", "warn_z", "fail_z", "rows"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 },
        "warn_z": { "type": "number", "minimum": 0 },
        "fail_z": { "type": "number", "minimum": 0 },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["case", "case_tier", "parity_scope", "seed", "status", "max_z", "worst"],
            "properties": {
              "case": { "type": "string", "minLength": 1 },
              "case_tier": { "type": "string", "enum": ["supported", "pathological_control"] },
              "parity_scope": { "type": "string", "enum": ["required", "informational"] },
              "seed": { "type": "integer", "minimum": 0 },
              "status": { "type": "string", "enum": ["ok", "warn", "failed"] },
              "reason": { "type": "string" },
              "max_z": { "type": ["number", "null"], "minimum": 0 },
              "worst": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["param", "z"],
                  "properties": {
                    "param": { "type": "string", "minLength": 1 },
                    "z": { "type": "number", "minimum": 0 }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
