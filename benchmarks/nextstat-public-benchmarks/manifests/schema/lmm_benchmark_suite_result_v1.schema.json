{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nextstat.io/schemas/benchmarks/lmm_benchmark_suite_result_v1.schema.json",
  "title": "NextStat LMM Benchmark Suite Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite", "meta", "cases", "summary"],
  "properties": {
    "schema_version": { "const": "nextstat.lmm_benchmark_suite_result.v1" },
    "suite": { "const": "lmm" },
    "meta": {
      "type": "object",
      "additionalProperties": true,
      "required": ["python", "platform", "nextstat_version"],
      "properties": {
        "python": { "type": "string" },
        "platform": { "type": "string" },
        "nextstat_version": { "type": "string" }
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case",
          "path",
          "sha256",
          "status",
          "n_groups",
          "n_per_group",
          "random_slope",
          "wall_time_median_s",
          "parity_status"
        ],
        "properties": {
          "case": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "status": { "type": "string", "enum": ["ok", "warn", "failed"] },
          "n_groups": { "type": "integer", "minimum": 1 },
          "n_per_group": { "type": "integer", "minimum": 1 },
          "random_slope": { "type": "boolean" },
          "wall_time_median_s": { "type": "number", "minimum": 0 },
          "parity_status": { "type": "string", "enum": ["ok", "warn", "skipped"] }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n_cases", "n_ok", "n_warn", "n_failed", "worst_case"],
      "properties": {
        "n_cases": { "type": "integer", "minimum": 0 },
        "n_ok": { "type": "integer", "minimum": 0 },
        "n_warn": { "type": "integer", "minimum": 0 },
        "n_failed": { "type": "integer", "minimum": 0 },
        "worst_case": { "type": "string" }
      }
    }
  }
}

