{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nextstat.io/schemas/hep/simplified_likelihood_export_report_v0.schema.json",
  "title": "Simplified Likelihood Export Report v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "support_class",
    "source",
    "metadata",
    "selection",
    "reduction",
    "jacobian",
    "fidelity_smoke",
    "output",
    "diagnostics",
    "unsupported_semantics",
    "explicit_boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": "nextstat_simplified_likelihood_export_report_v0"
    },
    "status": {
      "const": "ok"
    },
    "support_class": {
      "type": "string",
      "enum": ["research-grade", "stable"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_format",
        "fit_result_schema_version",
        "poi_name"
      ],
      "properties": {
        "workspace_format": {
          "type": "string",
          "enum": ["pyhf", "hs3"]
        },
        "workspace_schema_version": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "fit_result_schema_version": {
          "type": "string",
          "minLength": 1
        },
        "poi_name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experiment",
        "analysis_id",
        "source_format",
        "reference"
      ],
      "properties": {
        "experiment": {
          "type": "string",
          "minLength": 1
        },
        "analysis_id": {
          "type": "string",
          "minLength": 1
        },
        "source_format": {
          "const": "derived_from_workspace"
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channels"],
      "properties": {
        "channels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "bins": {
          "type": ["array", "null"],
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "reduction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_uncertainty_model",
        "basis_method",
        "explained_variance_target",
        "constraint_covariance_source",
        "split_stat_covariance"
      ],
      "properties": {
        "output_uncertainty_model": {
          "const": "basis"
        },
        "basis_method": {
          "const": "eigen"
        },
        "explained_variance_target": {
          "type": "number",
          "exclusiveMinimum": 0.0,
          "maximum": 1.0
        },
        "constraint_covariance_source": {
          "type": "string",
          "enum": ["source_model_constraints", "aligned_fit_covariance"]
        },
        "max_components": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "split_stat_covariance": {
          "type": "boolean"
        }
      }
    },
    "jacobian": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "relative_step",
        "absolute_step_floor"
      ],
      "properties": {
        "method": {
          "const": "finite_difference"
        },
        "relative_step": {
          "type": "number",
          "exclusiveMinimum": 0.0
        },
        "absolute_step_floor": {
          "type": "number",
          "exclusiveMinimum": 0.0
        }
      }
    },
    "fidelity_smoke": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "random_draws",
        "qmu_test_mu",
        "upper_limit_cl"
      ],
      "properties": {
        "random_draws": {
          "type": "integer",
          "minimum": 1
        },
        "qmu_test_mu": {
          "type": "number"
        },
        "upper_limit_cl": {
          "type": "number",
          "exclusiveMinimum": 0.0,
          "exclusiveMaximum": 1.0
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "uncertainty_model_kind",
        "bins_count",
        "full_nuisance_count",
        "reduced_nuisance_count",
        "reduction_ratio",
        "json_bytes",
        "json_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "nextstat_simplified_likelihood_v0"
        },
        "uncertainty_model_kind": {
          "const": "basis"
        },
        "bins_count": {
          "type": "integer",
          "minimum": 1
        },
        "full_nuisance_count": {
          "type": "integer",
          "minimum": 0
        },
        "reduced_nuisance_count": {
          "type": "integer",
          "minimum": 0
        },
        "reduction_ratio": {
          "type": "number",
          "minimum": 0.0
        },
        "json_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "json_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factorization", "fidelity"],
      "properties": {
        "factorization": {
          "$ref": "#/$defs/factorization"
        },
        "fidelity": {
          "$ref": "#/$defs/fidelity"
        }
      }
    },
    "unsupported_semantics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "explicit_boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "factorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "original_rank",
        "retained_rank",
        "explained_variance_fraction",
        "frobenius_residual",
        "clipped_negative_eigenvalues",
        "max_clipped_negative_eigenvalue_magnitude",
        "input_trace",
        "retained_trace"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "original_rank": {
          "type": "integer",
          "minimum": 0
        },
        "retained_rank": {
          "type": "integer",
          "minimum": 0
        },
        "explained_variance_fraction": {
          "type": "number",
          "minimum": 0.0
        },
        "frobenius_residual": {
          "type": "number",
          "minimum": 0.0
        },
        "clipped_negative_eigenvalues": {
          "type": "integer",
          "minimum": 0
        },
        "max_clipped_negative_eigenvalue_magnitude": {
          "type": "number",
          "minimum": 0.0
        },
        "input_trace": {
          "type": "number"
        },
        "retained_trace": {
          "type": "number"
        },
        "stat_covariance_trace": {
          "type": ["number", "null"]
        },
        "shared_systematic_trace": {
          "type": ["number", "null"]
        }
      }
    },
    "fidelity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nuisance_count_full",
        "nuisance_count_reduced",
        "bins_count",
        "relative_background_cov_residual",
        "max_abs_expected_delta_at_nominal",
        "max_abs_expected_delta_random_draws",
        "qmu_delta_smoke",
        "upper_limit_ratio_smoke",
        "max_abs_yield_delta",
        "max_rel_yield_delta"
      ],
      "properties": {
        "nuisance_count_full": {
          "type": "integer",
          "minimum": 0
        },
        "nuisance_count_reduced": {
          "type": "integer",
          "minimum": 0
        },
        "bins_count": {
          "type": "integer",
          "minimum": 1
        },
        "relative_background_cov_residual": {
          "type": "number",
          "minimum": 0.0
        },
        "max_abs_expected_delta_at_nominal": {
          "type": "number",
          "minimum": 0.0
        },
        "max_abs_expected_delta_random_draws": {
          "type": "number",
          "minimum": 0.0
        },
        "qmu_delta_smoke": {
          "type": "number",
          "minimum": 0.0
        },
        "upper_limit_ratio_smoke": {
          "type": "number",
          "minimum": 0.0
        },
        "max_abs_yield_delta": {
          "type": "number",
          "minimum": 0.0
        },
        "max_rel_yield_delta": {
          "type": "number",
          "minimum": 0.0
        }
      }
    }
  }
}
