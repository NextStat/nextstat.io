{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nextstat.io/schemas/pharma/bayesian_prior_conflict_diagnostic_v0.schema.json",
  "title": "NextStat Bayesian Prior Conflict Diagnostic v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stability",
    "diagnostic_id",
    "design_family",
    "design_id",
    "source_report_schema_version",
    "source_prior_sensitivity_schema_version",
    "generated_from_frozen_report",
    "baseline_variant_id",
    "baseline_recommended_action",
    "reported_variant_count",
    "conflict_severity",
    "decision_instability",
    "thresholds",
    "metrics",
    "rationale",
    "variant_summaries"
  ],
  "properties": {
    "schema_version": {
      "const": "nextstat_bayesian_prior_conflict_diagnostic_v0"
    },
    "stability": {
      "const": "research-grade"
    },
    "diagnostic_id": {
      "type": "string",
      "minLength": 1
    },
    "design_family": {
      "type": "string",
      "enum": [
        "beta_binomial",
        "normal_normal"
      ]
    },
    "design_id": {
      "type": "string",
      "minLength": 1
    },
    "source_report_schema_version": {
      "type": "string",
      "enum": [
        "nextstat_beta_binomial_design_report_v0",
        "nextstat_normal_normal_design_report_v0"
      ]
    },
    "source_prior_sensitivity_schema_version": {
      "type": "string",
      "enum": [
        "nextstat_beta_binomial_prior_sensitivity_report_v0",
        "nextstat_normal_normal_prior_sensitivity_report_v0"
      ]
    },
    "generated_from_frozen_report": {
      "const": true
    },
    "baseline_variant_id": {
      "type": "string",
      "minLength": 1
    },
    "baseline_recommended_action": {
      "type": "string",
      "enum": [
        "continue",
        "stop_for_success",
        "stop_for_futility"
      ]
    },
    "reported_variant_count": {
      "type": "integer",
      "minimum": 1
    },
    "conflict_severity": {
      "type": "string",
      "enum": [
        "low",
        "moderate",
        "high"
      ]
    },
    "decision_instability": {
      "type": "boolean"
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "high_recommended_action_flip_count_threshold",
        "moderate_decision_margin_ratio_threshold",
        "moderate_eventual_success_probability_range_threshold",
        "moderate_expected_total_sample_size_range_fraction_threshold"
      ],
      "properties": {
        "high_recommended_action_flip_count_threshold": {
          "const": 1
        },
        "moderate_decision_margin_ratio_threshold": {
          "const": 0.5
        },
        "moderate_eventual_success_probability_range_threshold": {
          "const": 0.25
        },
        "moderate_expected_total_sample_size_range_fraction_threshold": {
          "const": 0.25
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_posterior_probability_gt_margin",
        "success_threshold",
        "futility_threshold",
        "nearest_decision_threshold_margin",
        "decision_margin_ratio",
        "posterior_probability_range",
        "eventual_success_probability_range",
        "expected_total_sample_size_range",
        "expected_total_sample_size_range_fraction_of_plan",
        "max_abs_posterior_probability_delta_vs_baseline",
        "max_abs_eventual_success_probability_delta_vs_baseline",
        "max_abs_expected_total_sample_size_delta_vs_baseline",
        "recommended_action_flip_count",
        "recommended_action_flip_variant_ids"
      ],
      "properties": {
        "baseline_posterior_probability_gt_margin": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "success_threshold": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "futility_threshold": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "nearest_decision_threshold_margin": {
          "type": "number",
          "minimum": 0.0
        },
        "decision_margin_ratio": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0.0
        },
        "posterior_probability_range": {
          "type": "number",
          "minimum": 0.0
        },
        "eventual_success_probability_range": {
          "type": "number",
          "minimum": 0.0
        },
        "expected_total_sample_size_range": {
          "type": "number",
          "minimum": 0.0
        },
        "expected_total_sample_size_range_fraction_of_plan": {
          "type": "number",
          "minimum": 0.0
        },
        "max_abs_posterior_probability_delta_vs_baseline": {
          "type": "number",
          "minimum": 0.0
        },
        "max_abs_eventual_success_probability_delta_vs_baseline": {
          "type": "number",
          "minimum": 0.0
        },
        "max_abs_expected_total_sample_size_delta_vs_baseline": {
          "type": "number",
          "minimum": 0.0
        },
        "recommended_action_flip_count": {
          "type": "integer",
          "minimum": 0
        },
        "recommended_action_flip_variant_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "rationale": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "variant_summaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "variant_id",
          "is_baseline",
          "recommended_action",
          "posterior_probability_gt_margin",
          "eventual_success_probability",
          "expected_total_sample_size",
          "posterior_probability_delta_vs_baseline",
          "eventual_success_probability_delta_vs_baseline",
          "expected_total_sample_size_delta_vs_baseline"
        ],
        "properties": {
          "variant_id": {
            "type": "string",
            "minLength": 1
          },
          "is_baseline": {
            "type": "boolean"
          },
          "recommended_action": {
            "type": "string",
            "enum": [
              "continue",
              "stop_for_success",
              "stop_for_futility"
            ]
          },
          "posterior_probability_gt_margin": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "eventual_success_probability": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "expected_total_sample_size": {
            "type": "number",
            "minimum": 0.0
          },
          "posterior_probability_delta_vs_baseline": {
            "type": "number"
          },
          "eventual_success_probability_delta_vs_baseline": {
            "type": "number"
          },
          "expected_total_sample_size_delta_vs_baseline": {
            "type": "number"
          }
        }
      }
    }
  }
}
