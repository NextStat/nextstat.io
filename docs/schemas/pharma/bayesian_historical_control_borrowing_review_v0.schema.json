{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nextstat.io/schemas/pharma/bayesian_historical_control_borrowing_review_v0.schema.json",
  "title": "Bayesian Historical-Control Borrowing Review v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stability",
    "review_id",
    "design_family",
    "design_id",
    "policy_id",
    "borrowing_model",
    "source_report_schema_version",
    "source_policy_schema_version",
    "source_prior_conflict_schema_version",
    "generated_from_frozen_report",
    "recommended_borrowing_state",
    "borrowing_eligible",
    "current_effective_borrowing_fraction",
    "current_effective_historical_control_sample_size",
    "borrowing_strength",
    "gating",
    "diagnostics",
    "historical_sources",
    "rationale"
  ],
  "properties": {
    "schema_version": {
      "const": "nextstat_bayesian_historical_control_borrowing_review_v0"
    },
    "stability": {
      "const": "research-grade"
    },
    "review_id": {
      "type": "string",
      "minLength": 1
    },
    "design_family": {
      "enum": ["beta_binomial", "normal_normal"]
    },
    "design_id": {
      "type": "string",
      "minLength": 1
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "borrowing_model": {
      "enum": ["power_prior", "commensurate"]
    },
    "source_report_schema_version": {
      "enum": [
        "nextstat_beta_binomial_design_report_v0",
        "nextstat_normal_normal_design_report_v0"
      ]
    },
    "source_policy_schema_version": {
      "const": "nextstat_bayesian_historical_control_borrowing_policy_v0"
    },
    "source_prior_conflict_schema_version": {
      "const": "nextstat_bayesian_prior_conflict_diagnostic_v0"
    },
    "generated_from_frozen_report": {
      "const": true
    },
    "recommended_borrowing_state": {
      "enum": ["retain", "taper", "suspend"]
    },
    "borrowing_eligible": {
      "type": "boolean"
    },
    "current_effective_borrowing_fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "current_effective_historical_control_sample_size": {
      "type": "number",
      "minimum": 0
    },
    "borrowing_strength": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full_borrowing_fraction",
        "tapered_borrowing_fraction",
        "suspended_borrowing_fraction"
      ],
      "properties": {
        "full_borrowing_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "tapered_borrowing_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "suspended_borrowing_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "gating": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "meets_minimum_current_control_sample_size",
        "meets_minimum_control_information_fraction",
        "passes_action_flip_gate",
        "within_full_eventual_success_probability_range",
        "within_full_expected_total_sample_size_range_fraction"
      ],
      "properties": {
        "meets_minimum_current_control_sample_size": {
          "type": "boolean"
        },
        "meets_minimum_control_information_fraction": {
          "type": "boolean"
        },
        "passes_action_flip_gate": {
          "type": "boolean"
        },
        "within_full_eventual_success_probability_range": {
          "type": "boolean"
        },
        "within_full_expected_total_sample_size_range_fraction": {
          "type": "boolean"
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prior_conflict_severity",
        "decision_instability",
        "recommended_action_flip_count",
        "current_control_sample_size",
        "planned_control_sample_size",
        "current_control_information_fraction",
        "historical_source_count",
        "total_planned_historical_control_sample_size",
        "eventual_success_probability_range",
        "expected_total_sample_size_range_fraction_of_plan"
      ],
      "properties": {
        "prior_conflict_severity": {
          "enum": ["low", "moderate", "high"]
        },
        "decision_instability": {
          "type": "boolean"
        },
        "recommended_action_flip_count": {
          "type": "integer",
          "minimum": 0
        },
        "current_control_sample_size": {
          "type": "number",
          "minimum": 0
        },
        "planned_control_sample_size": {
          "type": "number",
          "minimum": 0
        },
        "current_control_information_fraction": {
          "type": "number",
          "minimum": 0
        },
        "historical_source_count": {
          "type": "integer",
          "minimum": 1
        },
        "total_planned_historical_control_sample_size": {
          "type": "number",
          "minimum": 0
        },
        "eventual_success_probability_range": {
          "type": "number",
          "minimum": 0
        },
        "expected_total_sample_size_range_fraction_of_plan": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "historical_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "source_role",
          "planned_control_sample_size",
          "exchangeability_assessment",
          "data_cut_label"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "source_role": {
            "enum": ["external_control_arm", "legacy_internal_control"]
          },
          "planned_control_sample_size": {
            "type": "number",
            "minimum": 0
          },
          "exchangeability_assessment": {
            "enum": ["low", "moderate", "high"]
          },
          "data_cut_label": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "rationale": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
