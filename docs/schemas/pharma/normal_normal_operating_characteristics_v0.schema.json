{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nextstat.io/schemas/pharma/normal_normal_operating_characteristics_v0.schema.json",
  "title": "Normal-Normal Bayesian Trial Operating Characteristics v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stability",
    "design_id",
    "n_replicates",
    "seed",
    "scenarios"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "nextstat_normal_normal_operating_characteristics_v0"
    },
    "stability": {
      "type": "string",
      "const": "research-grade"
    },
    "design_id": {
      "type": "string",
      "minLength": 1
    },
    "n_replicates": {
      "type": "integer",
      "minimum": 1
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scenario_oc" }
    }
  },
  "$defs": {
    "look_oc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "look_id",
        "stop_probability",
        "success_probability",
        "futility_probability"
      ],
      "properties": {
        "look_id": {
          "type": "string",
          "minLength": 1
        },
        "stop_probability": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "success_probability": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "futility_probability": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      }
    },
    "scenario_oc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "mean_control",
        "mean_treatment",
        "success_rate",
        "futility_rate",
        "no_decision_rate",
        "expected_total_sample_size",
        "look_summaries"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "mean_control": { "type": "number" },
        "mean_treatment": { "type": "number" },
        "success_rate": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "futility_rate": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "no_decision_rate": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "expected_total_sample_size": {
          "type": "number",
          "minimum": 0.0
        },
        "look_summaries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/look_oc" }
        }
      }
    }
  }
}
