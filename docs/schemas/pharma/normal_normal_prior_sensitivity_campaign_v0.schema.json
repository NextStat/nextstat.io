{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nextstat.io/schemas/pharma/normal_normal_prior_sensitivity_campaign_v0.schema.json",
  "title": "Normal-Normal Prior Sensitivity Campaign v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "variants"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "nextstat_normal_normal_prior_sensitivity_campaign_v0"
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/variant"
      }
    }
  },
  "$defs": {
    "prior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mean", "sd"],
      "properties": {
        "mean": {
          "type": "number"
        },
        "sd": {
          "type": "number",
          "exclusiveMinimum": 0.0
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "control_prior", "treatment_prior"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "control_prior": {
          "$ref": "#/$defs/prior"
        },
        "treatment_prior": {
          "$ref": "#/$defs/prior"
        }
      }
    }
  }
}
