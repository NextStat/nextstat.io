{
  "$id": "https://nextstat.io/schemas/benchmarks/m15_reporting_benchmark_compare_report_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M15 Reporting Benchmark Compare Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite",
    "status",
    "ok",
    "requires_review",
    "baseline_path",
    "current_path",
    "policy",
    "artifacts",
    "environment_checks",
    "summary",
    "derived",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "nextstat.m15_reporting_benchmark_compare_report.v1"
    },
    "suite": {
      "const": "m15_reporting"
    },
    "status": {
      "enum": [
        "passed",
        "review",
        "failed"
      ]
    },
    "ok": {
      "type": "boolean"
    },
    "requires_review": {
      "type": "boolean"
    },
    "baseline_path": {
      "type": "string"
    },
    "current_path": {
      "type": "string"
    },
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline",
        "current"
      ],
      "properties": {
        "baseline": {
          "$ref": "#/$defs/artifact"
        },
        "current": {
          "$ref": "#/$defs/artifact"
        }
      }
    },
    "environment_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_policy",
        "hostname",
        "release_build",
        "deterministic",
        "non_smoke",
        "runs",
        "warmups",
        "case_set"
      ],
      "properties": {
        "host_policy": {
          "$ref": "#/$defs/check"
        },
        "hostname": {
          "$ref": "#/$defs/check"
        },
        "release_build": {
          "$ref": "#/$defs/check"
        },
        "deterministic": {
          "$ref": "#/$defs/check"
        },
        "non_smoke": {
          "$ref": "#/$defs/check"
        },
        "runs": {
          "$ref": "#/$defs/check"
        },
        "warmups": {
          "$ref": "#/$defs/check"
        },
        "case_set": {
          "$ref": "#/$defs/case_set"
        }
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "derived": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validation_pack_m15_over_base_median_ratio"
      ],
      "properties": {
        "validation_pack_m15_over_base_median_ratio": {
          "$ref": "#/$defs/metric"
        }
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/case_report"
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "schema_version",
        "suite",
        "deterministic",
        "host_policy",
        "hostname",
        "build_profile",
        "version",
        "smoke",
        "runs",
        "warmups",
        "case_ids"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "schema_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "suite": {
          "type": [
            "string",
            "null"
          ]
        },
        "deterministic": {
          "type": "boolean"
        },
        "host_policy": {
          "type": [
            "string",
            "null"
          ]
        },
        "hostname": {
          "type": [
            "string",
            "null"
          ]
        },
        "build_profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "smoke": {
          "type": "boolean"
        },
        "runs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "warmups": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "case_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "baseline",
        "current",
        "matches"
      ],
      "properties": {
        "required": {},
        "baseline": {},
        "current": {},
        "matches": {
          "type": "boolean"
        }
      }
    },
    "case_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "baseline",
        "current",
        "matches"
      ],
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "baseline": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "current": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "matches": {
          "type": "boolean"
        }
      }
    },
    "metric_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_ratio",
        "fail_ratio",
        "min_baseline_value"
      ],
      "properties": {
        "review_ratio": {
          "type": "number",
          "minimum": 0
        },
        "fail_ratio": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "min_baseline_value": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "required_host_policy",
        "required_hostname",
        "required_build_profile",
        "require_non_smoke",
        "required_runs",
        "required_warmups",
        "case_ids",
        "cli_metric",
        "validation_pack_metric",
        "derived_ratio_metric"
      ],
      "properties": {
        "schema_version": {
          "const": "nextstat.m15_reporting_benchmark_compare_policy.v1"
        },
        "required_host_policy": {
          "const": "nextstat-bench"
        },
        "required_hostname": {
          "const": "nextstat-bench"
        },
        "required_build_profile": {
          "const": "release"
        },
        "require_non_smoke": {
          "type": "boolean"
        },
        "required_runs": {
          "type": "integer",
          "minimum": 1
        },
        "required_warmups": {
          "type": "integer",
          "minimum": 0
        },
        "case_ids": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "string"
          }
        },
        "cli_metric": {
          "$ref": "#/$defs/metric_policy"
        },
        "validation_pack_metric": {
          "$ref": "#/$defs/metric_policy"
        },
        "derived_ratio_metric": {
          "$ref": "#/$defs/metric_policy"
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "baseline_value",
        "current_value",
        "ratio",
        "review_ratio",
        "fail_ratio",
        "min_baseline_value",
        "reasons"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "review",
            "failed",
            "skipped_floor",
            "not_applicable"
          ]
        },
        "baseline_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "current_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "ratio": {
          "type": [
            "number",
            "null"
          ]
        },
        "review_ratio": {
          "type": "number",
          "minimum": 0
        },
        "fail_ratio": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "min_baseline_value": {
          "type": "number",
          "minimum": 0
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "field_match": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline",
        "current",
        "matches"
      ],
      "properties": {
        "baseline": {},
        "current": {},
        "matches": {
          "type": "boolean"
        }
      }
    },
    "case_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "median_s",
        "min_s",
        "max_s",
        "runs",
        "warmups",
        "validated_schema_versions"
      ],
      "properties": {
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "median_s": {
          "type": [
            "number",
            "null"
          ]
        },
        "min_s": {
          "type": [
            "number",
            "null"
          ]
        },
        "max_s": {
          "type": [
            "number",
            "null"
          ]
        },
        "runs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "warmups": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "validated_schema_versions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "case_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "status",
        "ok",
        "requires_review",
        "reasons",
        "identity",
        "baseline",
        "current",
        "metrics"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "category": {
          "enum": [
            "cli",
            "validation_pack",
            "unknown"
          ]
        },
        "status": {
          "enum": [
            "passed",
            "review",
            "failed"
          ]
        },
        "ok": {
          "type": "boolean"
        },
        "requires_review": {
          "type": "boolean"
        },
        "reasons": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "errors",
            "warnings"
          ],
          "properties": {
            "errors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "case_status",
            "validated_schema_versions",
            "validated_artifact_count"
          ],
          "properties": {
            "case_status": {
              "$ref": "#/$defs/field_match"
            },
            "validated_schema_versions": {
              "$ref": "#/$defs/field_match"
            },
            "validated_artifact_count": {
              "$ref": "#/$defs/field_match"
            }
          }
        },
        "baseline": {
          "$ref": "#/$defs/case_snapshot"
        },
        "current": {
          "$ref": "#/$defs/case_snapshot"
        },
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/metric"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed_cases",
        "review_cases",
        "failed_cases",
        "metric_count",
        "passed_metrics",
        "review_metrics",
        "failed_metrics",
        "skipped_metrics",
        "top_level_errors",
        "top_level_warnings"
      ],
      "properties": {
        "passed_cases": {
          "type": "integer",
          "minimum": 0
        },
        "review_cases": {
          "type": "integer",
          "minimum": 0
        },
        "failed_cases": {
          "type": "integer",
          "minimum": 0
        },
        "metric_count": {
          "type": "integer",
          "minimum": 0
        },
        "passed_metrics": {
          "type": "integer",
          "minimum": 0
        },
        "review_metrics": {
          "type": "integer",
          "minimum": 0
        },
        "failed_metrics": {
          "type": "integer",
          "minimum": 0
        },
        "skipped_metrics": {
          "type": "integer",
          "minimum": 0
        },
        "top_level_errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "top_level_warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
