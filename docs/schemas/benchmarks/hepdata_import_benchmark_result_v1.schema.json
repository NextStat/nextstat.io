{
  "$id": "https://nextstat.io/schemas/benchmarks/hepdata_import_benchmark_result_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HEPData Import Benchmark Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite",
    "deterministic",
    "environment",
    "meta",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "nextstat.hepdata_import_benchmark_result.v1"
    },
    "suite": {
      "const": "hepdata_import"
    },
    "deterministic": {
      "type": "boolean"
    },
    "environment": {
      "type": "object"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_policy",
        "nextstat_command",
        "repeat",
        "fit_repeat",
        "smoke",
        "fit_enabled",
        "out",
        "work_root"
      ],
      "properties": {
        "host_policy": {
          "type": "string"
        },
        "nextstat_command": {
          "$ref": "#/$defs/command"
        },
        "repeat": {
          "type": "integer",
          "minimum": 1
        },
        "fit_repeat": {
          "type": "integer",
          "minimum": 1
        },
        "smoke": {
          "type": "boolean"
        },
        "fit_enabled": {
          "type": "boolean"
        },
        "out": {
          "type": "string"
        },
        "work_root": {
          "type": "string"
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "command": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repeat",
        "policy",
        "per_run_s",
        "best_s"
      ],
      "properties": {
        "repeat": {
          "type": "integer",
          "minimum": 0
        },
        "policy": {
          "const": "min"
        },
        "per_run_s": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "best_s": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "doi",
        "source_mode"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "doi": {
          "type": "string"
        },
        "source_mode": {
          "enum": [
            "curated",
            "direct_doi"
          ]
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "dataset_count",
        "workspace_count",
        "download_mode",
        "lockfile_written",
        "available_patch_names"
      ],
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "dataset_count": {
          "type": "integer",
          "minimum": 0
        },
        "workspace_count": {
          "type": "integer",
          "minimum": 0
        },
        "download_mode": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "cached",
            "network",
            null
          ]
        },
        "lockfile_written": {
          "type": "boolean"
        },
        "available_patch_names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lockfile",
        "workspaces"
      ],
      "properties": {
        "lockfile": {
          "type": [
            "string",
            "null"
          ]
        },
        "workspaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "fit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "workspace_kind",
        "timing",
        "command",
        "result"
      ],
      "properties": {
        "status": {
          "const": "ok"
        },
        "workspace_kind": {
          "enum": [
            "bkgonly",
            "patched"
          ]
        },
        "timing": {
          "$ref": "#/$defs/timing"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "converged",
            "bestfit_len"
          ],
          "properties": {
            "converged": {
              "type": "boolean"
            },
            "bestfit_len": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discovery_s",
        "download_s",
        "extract_s",
        "materialize_s",
        "fit_s",
        "import_total_s"
      ],
      "properties": {
        "discovery_s": {
          "type": "number",
          "minimum": 0
        },
        "download_s": {
          "type": "number",
          "minimum": 0
        },
        "extract_s": {
          "type": "number",
          "minimum": 0
        },
        "materialize_s": {
          "type": "number",
          "minimum": 0
        },
        "fit_s": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "import_total_s": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "command",
        "summary_mode",
        "source_mode",
        "timing",
        "stages",
        "dataset",
        "validation",
        "artifacts"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "failed"
          ]
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "summary_mode": {
          "enum": [
            "catalog",
            "materialize"
          ]
        },
        "source_mode": {
          "enum": [
            "curated",
            "direct_doi"
          ]
        },
        "timing": {
          "$ref": "#/$defs/timing"
        },
        "stages": {
          "$ref": "#/$defs/stages"
        },
        "dataset": {
          "$ref": "#/$defs/dataset"
        },
        "validation": {
          "$ref": "#/$defs/validation"
        },
        "artifacts": {
          "$ref": "#/$defs/artifacts"
        },
        "fit": {
          "$ref": "#/$defs/fit"
        },
        "error": {
          "type": "string"
        }
      }
    }
  }
}
