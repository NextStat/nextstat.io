{
  "$id": "https://nextstat.io/schemas/benchmarks/hepdata_import_benchmark_baseline_promotion_report_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HEPData Import Benchmark Baseline Promotion Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite",
    "status",
    "promoted",
    "allow_review",
    "dry_run",
    "timestamp_utc",
    "accepted_baseline_path",
    "candidate_path",
    "compare_report_path",
    "compare_status",
    "artifacts",
    "actions",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": "nextstat.hepdata_import_benchmark_baseline_promotion_report.v1"
    },
    "suite": {
      "const": "hepdata_import"
    },
    "status": {
      "enum": [
        "dry_run",
        "promoted",
        "failed"
      ]
    },
    "promoted": {
      "type": "boolean"
    },
    "allow_review": {
      "type": "boolean"
    },
    "dry_run": {
      "type": "boolean"
    },
    "timestamp_utc": {
      "type": "string"
    },
    "accepted_baseline_path": {
      "type": "string"
    },
    "candidate_path": {
      "type": "string"
    },
    "compare_report_path": {
      "type": "string"
    },
    "compare_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "passed",
        "review",
        "failed",
        null
      ]
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted_before",
        "candidate",
        "accepted_after"
      ],
      "properties": {
        "accepted_before": {
          "$ref": "#/$defs/artifact"
        },
        "candidate": {
          "$ref": "#/$defs/artifact"
        },
        "accepted_after": {
          "$ref": "#/$defs/artifact"
        }
      }
    },
    "actions": {
      "$ref": "#/$defs/actions"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "schema_version",
        "suite",
        "deterministic",
        "host_policy",
        "node",
        "smoke",
        "fit_enabled",
        "repeat",
        "fit_repeat",
        "case_ids"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "schema_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "suite": {
          "type": [
            "string",
            "null"
          ]
        },
        "deterministic": {
          "type": "boolean"
        },
        "host_policy": {
          "type": [
            "string",
            "null"
          ]
        },
        "node": {
          "type": [
            "string",
            "null"
          ]
        },
        "smoke": {
          "type": "boolean"
        },
        "fit_enabled": {
          "type": "boolean"
        },
        "repeat": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "fit_repeat": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "case_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archived_previous_baseline",
        "archived_previous_baseline_path",
        "archived_promoted_snapshot",
        "archived_promoted_snapshot_path",
        "accepted_updated",
        "history_dir"
      ],
      "properties": {
        "archived_previous_baseline": {
          "type": "boolean"
        },
        "archived_previous_baseline_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "archived_promoted_snapshot": {
          "type": "boolean"
        },
        "archived_promoted_snapshot_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "accepted_updated": {
          "type": "boolean"
        },
        "history_dir": {
          "type": "string"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "top_level_errors"
      ],
      "properties": {
        "top_level_errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
