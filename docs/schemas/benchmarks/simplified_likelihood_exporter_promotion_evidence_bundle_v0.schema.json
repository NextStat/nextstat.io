{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nextstat.io/schemas/benchmarks/simplified_likelihood_exporter_promotion_evidence_bundle_v0.schema.json",
  "title": "Simplified Likelihood Exporter Promotion Evidence Bundle v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "surface",
    "bundle_kind",
    "support_class",
    "generated_at_utc",
    "source_snapshot",
    "exporter_surface",
    "promotion_claims",
    "artifacts",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "nextstat_simplified_likelihood_exporter_promotion_evidence_bundle_v0"
    },
    "surface": {
      "type": "string",
      "const": "simplified_likelihood_exporter"
    },
    "bundle_kind": {
      "type": "string",
      "const": "promotion_readiness_evidence"
    },
    "support_class": {
      "type": "string",
      "const": "research-grade"
    },
    "generated_at_utc": {
      "type": "string",
      "minLength": 1
    },
    "source_snapshot": {
      "$ref": "#/$defs/source_snapshot"
    },
    "exporter_surface": {
      "$ref": "#/$defs/exporter_surface"
    },
    "promotion_claims": {
      "$ref": "#/$defs/promotion_claims"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "kind",
        "required",
        "source_path",
        "bundle_path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "source_path": { "type": "string", "minLength": 1 },
        "bundle_path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "source_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "bundle_path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "source_path": { "type": "string", "minLength": 1 },
        "bundle_path": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "string", "minLength": 1 },
        "suite": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "source_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "benchmark_host",
        "persisted_snapshot",
        "all_schema_valid",
        "all_fidelity_gates_pass",
        "all_performance_gates_pass",
        "export_matrix_case_count",
        "synthetic_case_count",
        "public_reinterpretation_style_case_count",
        "max_abs_q_mu_diff",
        "max_upper_limit_ratio_deviation",
        "min_net_end_to_end_upper_limit_speedup",
        "overall_min_net_end_to_end_upper_limit_speedup",
        "public_reinterpretation_style_min_net_end_to_end_upper_limit_speedup"
      ],
      "properties": {
        "status": { "type": "string", "enum": ["ok", "fail"] },
        "benchmark_host": { "type": "string", "minLength": 1 },
        "persisted_snapshot": { "type": "boolean" },
        "all_schema_valid": { "type": "boolean" },
        "all_fidelity_gates_pass": { "type": "boolean" },
        "all_performance_gates_pass": { "type": "boolean" },
        "export_matrix_case_count": { "type": "integer", "minimum": 1 },
        "synthetic_case_count": { "type": "integer", "minimum": 0 },
        "public_reinterpretation_style_case_count": { "type": "integer", "minimum": 0 },
        "max_abs_q_mu_diff": { "type": "number", "minimum": 0.0 },
        "max_upper_limit_ratio_deviation": { "type": "number", "minimum": 0.0 },
        "min_net_end_to_end_upper_limit_speedup": { "type": "number", "minimum": 0.0 },
        "overall_min_net_end_to_end_upper_limit_speedup": { "type": "number", "minimum": 0.0 },
        "public_reinterpretation_style_min_net_end_to_end_upper_limit_speedup": {
          "type": "number",
          "minimum": 0.0
        }
      }
    },
    "source_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "benchmark_artifact",
        "snapshot_report",
        "snapshot_index",
        "summary"
      ],
      "properties": {
        "benchmark_artifact": { "$ref": "#/$defs/source_file" },
        "snapshot_report": { "$ref": "#/$defs/source_file" },
        "snapshot_index": { "$ref": "#/$defs/source_file" },
        "summary": { "$ref": "#/$defs/source_summary" }
      }
    },
    "exporter_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted_command_names",
        "accepted_schema_names",
        "explicit_boundaries"
      ],
      "properties": {
        "accepted_command_names": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "accepted_schema_names": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "explicit_boundaries": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "promotion_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "research_grade_acceptance_supported",
        "future_stable_review_ready",
        "committed_snapshot_supported"
      ],
      "properties": {
        "research_grade_acceptance_supported": { "type": "boolean" },
        "future_stable_review_ready": { "type": "boolean" },
        "committed_snapshot_supported": { "type": "boolean" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "artifact_count",
        "required_artifact_count",
        "benchmark_host",
        "supports_future_stable_review",
        "supports_committed_snapshot"
      ],
      "properties": {
        "status": { "type": "string", "enum": ["ok", "fail"] },
        "artifact_count": { "type": "integer", "minimum": 1 },
        "required_artifact_count": { "type": "integer", "minimum": 1 },
        "benchmark_host": { "type": "string", "minLength": 1 },
        "supports_future_stable_review": { "type": "boolean" },
        "supports_committed_snapshot": { "type": "boolean" }
      }
    }
  }
}
