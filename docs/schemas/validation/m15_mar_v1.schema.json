{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nextstat.io/schemas/validation/m15_mar_v1.schema.json",
  "title": "NextStat ICH M15 Model Analysis Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_status",
    "jurisdiction_profile",
    "profile_requirements",
    "context_of_use",
    "based_on_map_ref",
    "questions",
    "executed_datasets",
    "methods_executed",
    "criterion_results",
    "deviations",
    "limitations",
    "governance",
    "signoff",
    "linked_artifacts"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "m15_mar_v1"
    },
    "generated_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "document_status": {
      "type": "string",
      "enum": ["draft", "reviewed", "approved"]
    },
    "jurisdiction_profile": {
      "type": "string",
      "enum": ["ich_core", "ema_step5_2026", "fda_draft_2024"]
    },
    "profile_requirements": {
      "$ref": "#/$defs/profile_requirements"
    },
    "context_of_use": {
      "type": "string",
      "minLength": 1
    },
    "based_on_map_ref": {
      "type": "string",
      "minLength": 1
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/question_result" }
    },
    "executed_datasets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/dataset_result" }
    },
    "methods_executed": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/method_result" }
    },
    "criterion_results": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/criterion_result" }
    },
    "deviations": {
      "type": "array",
      "items": { "$ref": "#/$defs/deviation" }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "governance": {
      "$ref": "#/$defs/governance"
    },
    "signoff": {
      "$ref": "#/$defs/signoff"
    },
    "linked_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessment_table_ref", "validation_report_ref"],
      "properties": {
        "assessment_table_ref": {
          "type": "string",
          "minLength": 1
        },
        "validation_report_ref": {
          "type": "string",
          "minLength": 1
        },
        "pharma_validation_ref": {
          "type": ["string", "null"]
        }
      }
    }
  },
  "$defs": {
    "profile_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_label",
        "canonical_reference",
        "framing_heading",
        "framing_text",
        "mandatory_sections"
      ],
      "properties": {
        "profile_label": {
          "type": "string",
          "minLength": 1
        },
        "canonical_reference": {
          "type": "string",
          "minLength": 1
        },
        "framing_heading": {
          "type": "string",
          "minLength": 1
        },
        "framing_text": {
          "type": "string",
          "minLength": 1
        },
        "mandatory_sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "question_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_id",
        "question_of_interest",
        "conclusion_status",
        "conclusion",
        "evidence_refs"
      ],
      "properties": {
        "question_id": {
          "type": "string",
          "minLength": 1
        },
        "question_of_interest": {
          "type": "string",
          "minLength": 1
        },
        "conclusion_status": {
          "type": "string",
          "enum": ["supported", "not_supported", "inconclusive"]
        },
        "conclusion": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "dataset_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "provenance_ref"],
      "properties": {
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "provenance_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "method_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method_id", "status"],
      "properties": {
        "method_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["planned", "completed", "skipped", "failed"]
        },
        "notes": {
          "type": ["string", "null"]
        }
      }
    },
    "criterion_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion_id", "status"],
      "properties": {
        "criterion_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["met", "not_met", "not_evaluable"]
        },
        "observed_value": {
          "type": ["number", "string", "null"]
        },
        "notes": {
          "type": ["string", "null"]
        }
      }
    },
    "deviation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deviation_id", "description", "impact_assessment"],
      "properties": {
        "deviation_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "impact_assessment": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authors", "reviewers", "approvers"],
      "properties": {
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reviewers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "approvers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "signoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_author", "qa_reviewer", "approver", "status"],
      "properties": {
        "primary_author": {
          "type": "string",
          "minLength": 1
        },
        "qa_reviewer": {
          "type": "string",
          "minLength": 1
        },
        "approver": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["draft", "reviewed", "approved"]
        }
      }
    }
  }
}
